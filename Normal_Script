local function CreateToggleBtn(parent, text, pos, defaultConfig, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(0.48, 0, 0, 32)
    btn.Position = pos
    btn.BackgroundColor3 = defaultConfig and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(40, 40, 40)
    btn.Text = text .. (defaultConfig and ": ON" or ": OFF")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.SourceSansBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        local state = callback()
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(40, 40, 40)
        btn.Text = text .. (state and ": ON" or ": OFF")
    end)
    return btn
end


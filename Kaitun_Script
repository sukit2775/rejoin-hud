-- =================================================================
-- 6. MAIN KAITUN LOOP (1-700)
-- =================================================================
task.spawn(function()
    local lastLvl = 0

    while task.wait(0.1) do
        if _G.Config.MasterKaitun then
            pcall(function()
                local player = LocalPlayer
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.Humanoid.Health > 0 then
                    
                    EquipWeapon()

                    local currentLvl = GetPlayerLevel()
                    if lastLvl ~= 0 and currentLvl > lastLvl then
                        AddLog("🎉 เลเวลอัปเป็น: " .. currentLvl)
                    end
                    lastLvl = currentLvl

                    -- [ภารกิจพิเศษ] ตีเอาดาบ Saber เมื่อ Level 200+
                    if currentLvl >= 200 and _G.Config.AutoSaber and not HasSaber() then
                        local boss = MobFolder:FindFirstChild("Saber Expert") or Workspace:FindFirstChild("Saber Expert")
                        if boss and boss:FindFirstChild("Humanoid") and boss.Humanoid.Health > 0 then
                            AddLog("⚔️ กำลังตีบอส Saber Expert...")
                            player.Character.HumanoidRootPart.CFrame = boss.HumanoidRootPart.CFrame * CFrame.new(0, _G.Config.DistanceAboveMob, 0)
                        else
                            AddLog("⏳ วาร์ปไปจุดเกิดบอส Saber...")
                            SafeTween(CFrame.new(-1460, 30, -320))
                        end
                        return
                    end

                    -- [ภารกิจหลัก] ฟาร์มเวล 1-700
                    local qData = GetKaitunQuestData()
                    
                    local hasQuest = false
                    pcall(function() hasQuest = player.PlayerGui.MainQuest.Visible end)
                    
                    if not hasQuest then
                        CommF:InvokeServer("StartQuest", qData.Quest, qData.QuestID)
                        task.wait(0.5)
                    end

                    local targetMob = nil
                    for _, mob in pairs(MobFolder:GetChildren()) do
                        if mob:IsA("Model") and (mob.Name == qData.Mob or mob.Name:find(qData.Mob)) then
                            local hum = mob:FindFirstChild("Humanoid")
                            local hrp = mob:FindFirstChild("HumanoidRootPart")
                            if hum and hrp and hum.Health > 0 then
                                targetMob = mob
                                break
                            end
                        end
                    end

                    if not targetMob then
                        SafeTween(qData.CFrame)
                    else
                        local hum = targetMob:FindFirstChild("Humanoid")
                        local hrp = targetMob:FindFirstChild("HumanoidRootPart")
                        
                        while hum and hum.Health > 0 and _G.Config.MasterKaitun and hrp do
                            task.wait(0.01)
                            EquipWeapon()
                            
                            -- ลอยเหนือหัวมอนสเตอร์แบบ "ยืนตรง"
                            player.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, _G.Config.DistanceAboveMob, 0)
                            
                            -- ดึงมอนสเตอร์มารวม
                            BringMonstersToPoint(qData.Mob, hrp.CFrame)
                        end
                    end
                end
            end)
        end
    end
end)

